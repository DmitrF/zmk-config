#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Layer indices; bindings below use the numbers directly

#define ENG 0
#define UA 1
#define RU 2
#define PUNKT 3
#define NAV 4
#define ADJUST 5
#define SERVICE 6

/ {
    // Activate adjust layer by holding punkt and nav together

    conditional_layers {
        compatible = "zmk,conditional-layers";

        punkt_nav_to_adjust {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };

    macros {
        uml_u_small: uml_u_small {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp U>;
            label = "UML_U_SMALL";
        };

        uml_u_big: uml_u_big {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp LS(U)>;
            label = "UML_U_BIG";
        };

        uml_o_big: uml_o_big {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp LS(O)>;
            label = "UML_O_BIG";
        };

        uml_o_small: uml_o_small {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp O>;
            label = "UML_O_SMALL";
        };

        uml_a_big: uml_a_big {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp LS(A)>;
            label = "UML_A_BIG";
        };

        uml_a_small: uml_a_small {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp A>;
            label = "UML_A_SMALL";
        };

        del_line: del_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT) &kp LS(LG(RIGHT)) &kp BACKSPACE>;
            label = "DEL_LINE";
        };

        select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT) &kp LS(LA(RIGHT))>;
            label = "SELECT_WORD";
        };

        punkt_ua: punkt_ua {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&mo 3>,
                <&macro_tap>,
                <&kp LANG1>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 3>,
                <&macro_tap>,
                <&kp LANG2>;

            label = "PUNKT_UA";
        };

        punkt_ru: punkt_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&mo 3>,
                <&macro_tap>,
                <&kp LANG1>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 3>,
                <&macro_tap>,
                <&kp LANG3>;

            label = "PUNKT_RU";
        };

        to_ua: to_ua {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &to 1>;
            label = "TO_UA";
        };

        to_eng: to_eng {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &to 0>;
            label = "TO_ENG";
        };

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG3 &to 2>;
            label = "TO_RU";
        };
    };

    behaviors {
        uml_a_behavior: uml_a_behavior {
            compatible = "zmk,behavior-mod-morph";
            label = "UML_A_BEHAVIOR";
            bindings = <&uml_a_small>, <&uml_a_big>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        uml_o_behavior: uml_o_behavior {
            compatible = "zmk,behavior-mod-morph";
            label = "UML_O_BEHAVIOR";
            bindings = <&uml_o_small>, <&uml_o_big>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        uml_u_behavior: uml_u_behavior {
            compatible = "zmk,behavior-mod-morph";
            label = "UML_U_BEHAVIOR";
            bindings = <&uml_u_small>, <&uml_u_big>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sz_behavior: sz_behavior {
            compatible = "zmk,behavior-mod-morph";
            label = "SZ_BEHAVIOR";
            bindings = <&kp LA(S)>, <&kp LA(S)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ls_combo {
            bindings = <&kp LSHFT>;
            key-positions = <27 28>;
            slow-release;
            layers = <0 1 2>;
            timeout-ms = <70>;
        };

        rs_combo {
            bindings = <&kp RSHFT>;
            key-positions = <31 32>;
            slow-release;
            layers = <0 1 2>;
            timeout-ms = <70>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        eng {
            display-name = "eng";
            bindings = <
&kp ESC    &kp N1  &kp N2            &kp N3    &kp N4    &kp N5                         &kp N6  &kp N7         &kp N8     &kp N9             &kp N0           &kp GRAVE
&kp TAB    &kp Q   &kp W             &kp E     &kp R     &kp T   &kp Y                          &kp U          &kp I      &kp O              &kp P            &uml_u_behavior
&to_ua     &kp A   &kp S             &kp D     &kp F     &kp G   &kp H                          &kp J          &kp K      &kp L              &uml_o_behavior  &uml_a_behavior
&kp LSHFT  &kp Z   &kp X             &kp C     &kp V     &kp B   &kp COMMA  &kp PERIOD  &kp N   &kp M          &kp COMMA  &kp DOT            &sz_behavior     &kp RSHFT
                   &kp LEFT_CONTROL  &kp LALT  &kp LGUI  &mo 3   &kp RET    &kp SPACE   &mo 4   &kp RIGHT_GUI  &kp RALT   &kp RIGHT_CONTROL
            >;
        };

        ua {
            display-name = "ua";
            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                               &kp N6  &kp N7    &kp N8     &kp N9     &kp N0             &kp BACKSLASH
&kp TAB    &kp Q   &kp W      &kp E     &kp R     &kp T      &kp Y                             &kp U     &kp I      &kp O      &kp P              &kp LBKT
&to_eng    &kp A   &kp S      &kp D     &kp F     &kp G      &kp H                             &kp J     &kp K      &kp L      &kp SEMI           &kp APOS
&kp LSHFT  &kp Z   &kp X      &kp C     &kp V     &kp B      &kp LS(SLASH)  &kp SLASH  &kp N   &kp M     &kp COMMA  &kp DOT    &kp RIGHT_BRACKET  &kp GRAVE
                   &kp LCTRL  &kp LALT  &kp LGUI  &punkt_ua  &kp ENTER      &kp SPACE  &mo 4   &kp RGUI  &kp RALT   &kp RCTRL
            >;
        };

        ru {
            display-name = "ru";
            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                               &kp N6  &kp N7    &kp N8     &kp N9     &kp N0             &kp BACKSLASH
&kp TAB    &kp Q   &kp W      &kp E     &kp R     &kp T      &kp Y                             &kp U     &kp I      &kp O      &kp P              &kp LBKT
&to_eng    &kp A   &kp S      &kp D     &kp F     &kp G      &kp H                             &kp J     &kp K      &kp L      &kp SEMI           &kp APOS
&kp LSHFT  &kp Z   &kp X      &kp C     &kp V     &kp B      &kp LS(SLASH)  &kp SLASH  &kp N   &kp M     &kp COMMA  &kp DOT    &kp RIGHT_BRACKET  &kp GRAVE
                   &kp LCTRL  &kp LALT  &kp LGUI  &punkt_ru  &kp ENTER      &kp SPACE  &mo 4   &kp RGUI  &kp RALT   &kp RCTRL
            >;
        };

        punkt {
            display-name = "punkt";
            bindings = <
&kp GRAVE       &none            &none   &none   &none   &none                                    &none     &none              &none                 &none                  &none              &none
&kp TAB         &kp EXCLAMATION  &kp N7  &kp N8  &kp N9  &kp ASTERISK  &kp LEFT_BRACKET                     &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES  &none
&kp QUESTION    &kp EQUAL        &kp N4  &kp N5  &kp N6  &kp PLUS      &kp UNDERSCORE                       &kp SEMICOLON      &kp COLON             &kp RA(MINUS)          &kp SQT            &kp NON_US_BACKSLASH
&kp LEFT_SHIFT  &kp N0           &kp N1  &kp N2  &kp N3  &kp MINUS     &kp COMMA         &kp DOT  &kp HASH  &kp BACKSLASH      &kp PIPE              &kp SLASH              &kp GLOBE          &kp RIGHT_SHIFT
                                 &trans  &trans  &trans  &trans        &trans            &trans   &trans    &trans             &trans                &trans
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
&kp ESC         &kp F1        &kp F2                  &kp F3              &kp F4             &kp F5                            &kp F6  &kp F7              &kp F8    &kp F9         &kp F10         &kp RG(BACKSPACE)
&trans          &select_word  &kp LS(LG(LEFT_ARROW))  &kp LS(UP)          &kp LS(LG(RIGHT))  &none   &kp DEL                           &kp LG(LEFT)        &kp UP    &kp LG(RIGHT)  &msc SCRL_UP    &kp PAGE_UP
&none           &none         &kp LS(LEFT)            &kp LS(DOWN_ARROW)  &kp LS(RIGHT)      &none   &kp BACKSPACE                     &kp LEFT            &kp DOWN  &kp RIGHT      &msc SCRL_DOWN  &kp PG_DN
&kp LEFT_SHIFT  &none         &kp LS(LA(LEFT))        &none               &kp LA(LS(RIGHT))  &none   &kp LC(O)      &del_line  &none   &kp LA(LEFT_ARROW)  &none     &kp LA(RIGHT)  &none           &kp RIGHT_SHIFT
                              &trans                  &trans              &trans             &trans  &kp LS(ENTER)  &trans     &trans  &trans              &trans    &trans
            >;
        };

        adjust {
            display-name = "adjust";
            bindings = <
&none  &none       &none             &none             &none             &none                        &to_eng  &to_ua          &to_ru          &none            &kp CAPSLOCK    &to_eng
&none  &none       &kp LS(N7)        &kp LS(N8)        &kp LS(N9)        &none  &kp DEL                        &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc SCRL_UP    &none
&none  &none       &kp LS(NUMBER_4)  &kp LS(N5)        &kp LS(NUMBER_6)  &none  &kp BACKSPACE                  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &none
&none  &kp LS(N0)  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &none  &none          &mo 6  &none    &none           &none           &none            &none           &none
                   &none             &none             &none             &none  &none          &none  &none    &none           &none           &none
            >;
        };

        service {
            display-name = "service";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                             &to_eng  &to_ua          &to_ru          &none            &kp CAPSLOCK    &to_eng
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &kp DEL                          &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc SCRL_UP    &none
&sys_reset         &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &kp BACKSPACE                    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &sys_reset
&bootloader        &none            &none            &none            &none            &none            &rgb_ug RGB_TOG  &none  &none    &none           &none           &none            &none           &bootloader
                                    &none            &none            &none            &none            &none            &none  &none    &none           &none           &none
            >;
        };
    };
};
